<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing of the user's is copied off the device: no cloud backup, no
  device-to-device transfer. Study progress lives in the browser storage
  for the site and is exported deliberately by the user, never in the
  background.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
