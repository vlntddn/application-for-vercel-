# Copy to keystore.properties (git-ignored) and fill in.
# Create the keystore first:
#   keytool -genkey -v -keystore patente-pro-release.jks \
#           -keyalg RSA -keysize 2048 -validity 10000 -alias patente-pro
storeFile=patente-pro-release.jks
storePassword=CHANGE_ME
keyAlias=patente-pro
keyPassword=CHANGE_ME
